{
  "name": "block-consult-dd",
  "version": "0.2.0",
  "private": true,
  "description": "Block Consult GmbH crypto / token / RWA / stablecoin due-diligence tool",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "productName": "Block Consult DD",
  "scripts": {
    "dev": "portless run --name block-consult-dd next dev -H 127.0.0.1",
    "dev:direct": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "next lint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migration": "prisma migrate dev --create-only",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "desktop:prepare": "node scripts/build-desktop.mjs",
    "desktop:start": "electron .",
    "desktop:pack": "node scripts/build-desktop.mjs --dir",
    "desktop:build": "node scripts/build-desktop.mjs --package",
    "desktop:smoke": "node scripts/smoke-desktop.mjs",
    "desktop:icon": "node scripts/generate-icon.mjs",
    "db:check-migrations": "tsx scripts/check-migrations.ts",
    "test:browser": "node scripts/verify-browser.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.1",
    "lucide-react": "^0.469.0",
    "next": "15.5.29",
    "openai": "^7.57.0",
    "playwright": "1.65.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tailwind-merge": "^2.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "electron": "45.3.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.33",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "5.1.1",
    "@axe-core/playwright": "4.14.0"
  },
  "author": "Block Consult GmbH",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blockconsult-org/block-consult-dd.git"
  },
  "homepage": "https://github.com/blockconsult-org/block-consult-dd#readme",
  "bugs": {
    "url": "https://github.com/blockconsult-org/block-consult-dd/issues"
  },
  "overrides": {
    "minimatch@>=7": "^11.0.9",
    "postcss": "$postcss",
    "deepmerge-ts": "8.0.2"
  }
}

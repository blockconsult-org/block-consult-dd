<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime exceptions for the app and its helper processes. -->
<plist version="1.0">
<dict>
  <!-- V8 needs JIT and writable executable memory. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Loads the Prisma query engine (.node) from Resources/server; also required for ad-hoc signed builds. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- The app runs a server on 127.0.0.1 and calls AI providers. These only take effect under App Sandbox. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>

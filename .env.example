# ---------------------------------------------------------------------------
# Block Consult DD: environment for running from source (npm run dev / start).
# The desktop app sets its own paths and needs no .env file.
# Copy to .env and adjust. Every value below has a working default.
# ---------------------------------------------------------------------------

# Database: a SQLite file, relative to prisma/. Migrations in prisma/migrations
# are applied when the server starts (or run `npm run db:migrate`).
DATABASE_URL="file:./dev.db"

# Generated reports and fetched source text.
STORAGE_DIR="./storage"

# Private app data, including secret.key, which encrypts saved API keys.
BC_DATA_DIR="./.bc-data"
# Or provide the 32-byte encryption key yourself (hex or base64).
# BC_SECRET_KEY=""

# AI providers are set up in the app under Settings: each user adds their own
# Claude or OpenAI API key, or uses the Claude Code or Codex CLI they are signed
# in to. Optional: a Claude API key read from the environment instead, used when
# Settings > Claude API is set to "ANTHROPIC_API_KEY from the environment".
# ANTHROPIC_API_KEY=""

# Report branding (defaults in src/lib/branding.ts).
BRAND_NAME="Block Consult GmbH"
BRAND_PREPARED_BY="Block Consult GmbH"
BRAND_FOOTER_TEXT="Private and confidential"
# BRAND_WEBSITE=""
# BRAND_ADDRESS=""

# Optional data connectors. Leave blank to enter that data by hand.
TAVILY_API_KEY=""
SERPAPI_API_KEY=""
COINGECKO_API_KEY=""
COINMARKETCAP_API_KEY=""
ETHERSCAN_API_KEY=""
# Request timeout (ms) for connectors that call the network.
CONNECTOR_TIMEOUT_MS="15000"

# For a self-hosted install that other people can reach: when set, each browser
# must enter this token once at /unlock. Leave blank on your own machine.
APP_ACCESS_TOKEN=""
